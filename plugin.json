{
    "id": "quickshare",
    "name": "Quick Share",
    "description": "Send and receive files, links and text with Android phones over Google Quick Share. No pairing, and fast Wi-Fi transfers even when the phone is on another network.",
    "version": "0.2.0",
    "author": "jhannesreimann",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "control-center"
    ],
    "icon": "share",
    "components": {
        "daemon": "./QuickShareDaemon.qml",
        "widget": "./QuickShareWidget.qml"
    },
    "settings": "./QuickShareSettings.qml",
    "requires_dms": ">=2.1.0",
    "dependencies": [
        "rust",
        "bluez",
        "networkmanager",
        "iw",
        "dnsmasq",
        "polkit",
        "xdg-utils"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
