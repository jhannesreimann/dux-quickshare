<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>dms-quickshare</vendor>
  <vendor_url>https://github.com/jhannesreimann/dms-quickshare</vendor_url>
  <action id="io.github.jhannesreimann.dms-quickshare.wifi-helper">
    <description>Create a temporary Wi-Fi interface for fast Quick Share transfers</description>
    <message>Quick Share wants to create a temporary Wi-Fi interface</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/dms-quickshare/wifi-helper</annotate>
  </action>
</policyconfig>
